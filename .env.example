# Renombra este archivo a .env y completa los valores

# Token de GitHub (opcional pero recomendado)
# Sin token: 60 requests/hora  |  Con token: 5000 requests/hora
# Crea el tuyo en: https://github.com/settings/tokens
GITHUB_TOKEN=

# Puerto del servidor (por defecto 5000)
PORT=5000

# Modo debug (true en desarrollo, false en producción)
FLASK_DEBUG=true
